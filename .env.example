# ============================================================
#  Diama — variables d'environnement (développement local)
#  Copier vers .env :  cp .env.example .env
#  .env est gitignoré — n'y mettre AUCUN secret de production.
# ============================================================

# --- PostgreSQL 16 (docker-compose : port hôte 5433) --------
DB_URL=jdbc:postgresql://localhost:5433/diama
DB_USER=diama
DB_PASSWORD=diama

# --- Redis (mot de passe requis par application.yaml) -------
REDIS_PASSWORD=eYVX7EwVmmxKPCDmwMtyKVge8oLd2t81
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# --- Kafka ---------------------------------------------------
KAFKA_BROKERS=localhost:9092

# --- Keycloak (realm transfer-app, docker-compose : 9080) ---
KEYCLOAK_URL=http://localhost:9080
KEYCLOAK_REALM=transfer-app
# Secret du client confidentiel quarkus-api (Console Keycloak →
# Clients → quarkus-api → Credentials après le premier import).
KEYCLOAK_API_SECRET=change-me-quarkus-api-secret
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Elasticsearch (Hibernate Search) ------------------------
ELASTIC_HOSTS=localhost:9200

# --- Thunes v2 (sandbox) -------------------------------------
THUNES_URL=https://api.sandbox.thunes.com
THUNES_API_KEY=change-me
THUNES_API_SECRET=change-me
THUNES_WEBHOOK_SECRET=change-me

# --- Swan.io (collecte EUR) ----------------------------------
SWAN_URL=https://api.swan.io
SWAN_OAUTH_URL=https://oauth.swan.io
SWAN_CLIENT_ID=change-me
SWAN_CLIENT_SECRET=change-me
SWAN_WEBHOOK_SECRET=change-me

# --- Sumsub (KYC) --------------------------------------------
SUMSUB_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=change-me
SUMSUB_APP_SECRET=change-me
SUMSUB_WEBHOOK_SECRET=change-me
