# ============================================================
#  Diama — variables d'environnement (développement local)
#  Copier vers .env :  cp .env.example .env
#  .env est gitignoré — n'y mettre AUCUN secret de production.
# ============================================================

# --- PostgreSQL 16 (docker-compose : port hôte 5433) --------
DB_URL=jdbc:postgresql://localhost:5433/diama
DB_USER=diama
DB_PASSWORD=diama

# --- Redis (mot de passe requis par application.yaml) -------
REDIS_PASSWORD=eYVX7EwVmmxKPCDmwMtyKVge8oLd2t81
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# --- Kafka ---------------------------------------------------
KAFKA_BROKERS=localhost:9092
# Identifiants du login Kafka UI (exposé sur diama-kafka.zalamtech.fr).
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change-me

# --- Keycloak mutualisé (dev + pilote prod) ------------------
# Issuer : https://auth.zalamtech.fr/realms/diama-transfer-app
KEYCLOAK_URL=https://auth.zalamtech.fr
KEYCLOAK_REALM=diama-transfer-app
# Secret du client confidentiel quarkus-api (Console Keycloak →
# Clients → quarkus-api → Credentials).
KEYCLOAK_API_SECRET=change-me-quarkus-api-secret

# --- Backoffice diama-admin (docker compose --profile app) ---
# Secret du client confidentiel backoffice-app.
KEYCLOAK_CLIENT_SECRET=change-me-backoffice-secret
# Clé de chiffrement de la session NextAuth (openssl rand -base64 32).
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=https://diama-admin.zalamtech.fr

# --- Elasticsearch (Hibernate Search) ------------------------
ELASTIC_HOSTS=localhost:9200

# --- Thunes v2 (sandbox) -------------------------------------
THUNES_URL=https://api.sandbox.thunes.com
THUNES_API_KEY=change-me
THUNES_API_SECRET=change-me
THUNES_WEBHOOK_SECRET=change-me

# --- Swan.io (collecte EUR) ----------------------------------
SWAN_URL=https://api.swan.io
SWAN_OAUTH_URL=https://oauth.swan.io
SWAN_CLIENT_ID=change-me
SWAN_CLIENT_SECRET=change-me
SWAN_WEBHOOK_SECRET=change-me

# --- Didit (KYC) ---------------------------------------------
# Console Didit → Developers → API keys / Webhooks ; un workflow publié par niveau.
DIDIT_URL=https://verification.didit.me
DIDIT_API_KEY=change-me
DIDIT_WEBHOOK_SECRET=change-me
# Redirection en fin de parcours hébergé (deep link mobile), optionnelle.
DIDIT_CALLBACK_URL=
DIDIT_WORKFLOW_LEVEL_1=change-me
DIDIT_WORKFLOW_LEVEL_2=change-me
DIDIT_WORKFLOW_LEVEL_3=change-me
DIDIT_WORKFLOW_LEVEL_4=change-me
