{
  "realm": "transfer-app",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "user", "description": "Utilisateur final (application mobile)" },
      { "name": "kyc-agent", "description": "Agent backoffice — revue KYC" },
      { "name": "ops-agent", "description": "Agent backoffice — opérations / transactions" },
      { "name": "admin", "description": "Administrateur backoffice" }
    ]
  },
  "defaultRoles": ["user"],
  "clientScopes": [
    {
      "name": "kyc-level",
      "description": "Propage l'attribut utilisateur kyc_level en claim JWT",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "kyc_level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "kyc_level",
            "claim.name": "kyc_level",
            "jsonType.label": "int",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mobile-app",
      "name": "Application mobile Diama",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": { "pkce.code.challenge.method": "S256" },
      "redirectUris": ["diama://auth/callback", "http://localhost:3000/*"],
      "webOrigins": ["+"],
      "defaultClientScopes": ["profile", "email", "phone", "roles", "kyc-level"]
    },
    {
      "clientId": "backoffice-app",
      "name": "Backoffice React Diama",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-backoffice-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["profile", "email", "roles", "kyc-level"]
    },
    {
      "clientId": "quarkus-api",
      "name": "API Quarkus (service account)",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-quarkus-api-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["roles"]
    }
  ],
  "users": [
    {
      "username": "admin@diama.local",
      "email": "admin@diama.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Diama",
      "credentials": [{ "type": "password", "value": "admin", "temporary": true }],
      "realmRoles": ["admin", "ops-agent", "kyc-agent"]
    }
  ]
}
